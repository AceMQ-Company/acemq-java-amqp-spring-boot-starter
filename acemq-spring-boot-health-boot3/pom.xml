<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.acemq</groupId>
    <artifactId>acemq-spring-boot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>acemq-spring-boot-health-boot3</artifactId>
  <packaging>jar</packaging>

  <name>AceMQ Spring Boot Health (Boot 2.7 and 3)</name>
  <description>The health indicator for Spring Boot 2.7 and 3, which share a health API in
    spring-boot-actuator under org.springframework.boot.actuate.health. Inert on Boot 4, where
    that package does not exist.</description>

  <properties>
    <!-- Java 11 bytecode, not the parent's 17, and the reason is the runtime rather
         than the compiler. Boot 2.7 applications are frequently still on Java 11, and
         a Java 11 JVM refuses any class file newer than major 55 - so a module built
         at 17 fails to load with UnsupportedClassVersionError before any condition on
         it is ever evaluated. Nothing here needs a Java 17 language feature.

         Verified against spring-boot-actuator 2.7.18 as well as 3.5.7: the health
         contributor API is binary compatible across both, which is what lets one
         module serve two Boot lines. The compiler's release flag constrains the JDK
         API, not third party jars, so that compatibility is a fact to be tested
         rather than assumed, and there is a CI dimension for it. -->
    <maven.compiler.release>11</maven.compiler.release>
    <!-- Tests stay at 17: they use records, and they only ever run on the build JDK. -->
    <maven.compiler.testRelease>17</maven.compiler.testRelease>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-core</artifactId>
      <version>${acemq.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
      <version>${spring.boot3.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <version>${spring.boot3.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Boot 3's actuator, which is where AbstractHealthIndicator lives on this
         line. The version is explicit rather than managed, because this module is
         compiled against Boot 3 whatever line the reactor is being built for. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
      <version>${spring.boot3.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- provided-scope dependencies are already on the test classpath, so the
         library and the health API are not repeated here. Declaring the same
         artifact twice in one POM is not an override: the last declaration wins,
         which would have made them test-only and broken the compile. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <version>${spring.boot3.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-test</artifactId>
      <version>${acemq.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-codec-json</artifactId>
      <version>${acemq.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-spring-boot-autoconfigure</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
