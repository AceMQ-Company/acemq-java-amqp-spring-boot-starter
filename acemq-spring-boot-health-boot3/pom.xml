<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.acemq</groupId>
    <artifactId>acemq-spring-boot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>acemq-spring-boot-health-boot3</artifactId>
  <packaging>jar</packaging>

  <name>AceMQ Spring Boot Health (Boot 3)</name>
  <description>The health indicator for Spring Boot 3, whose health API lives in
    spring-boot-actuator under org.springframework.boot.actuate.health. Inert on Boot 4, where
    that package does not exist.</description>

  <dependencies>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-core</artifactId>
      <version>${acemq.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
      <version>${spring.boot3.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <version>${spring.boot3.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Boot 3's actuator, which is where AbstractHealthIndicator lives on this
         line. The version is explicit rather than managed, because this module is
         compiled against Boot 3 whatever line the reactor is being built for. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
      <version>${spring.boot3.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- provided-scope dependencies are already on the test classpath, so the
         library and the health API are not repeated here. Declaring the same
         artifact twice in one POM is not an override: the last declaration wins,
         which would have made them test-only and broken the compile. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <version>${spring.boot3.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-test</artifactId>
      <version>${acemq.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-codec-json</artifactId>
      <version>${acemq.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-spring-boot-autoconfigure</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
